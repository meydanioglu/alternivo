{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Api": {
    "InternalKey": ""
  },
  "Auth": {
    "RequireConfirmedEmail": true
  },
  "Admin": {
    "Email": "",
    "Password": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "OnStartup": false
  },
  "Swagger": {
    "Enabled": false
  },
  "DataProtection": {
    "KeysPath": "/app/keys"
  },
  "Catalog": {
    "ShowDemoData": false,
    "HomeCacheSeconds": 300,
    "DetailCacheSeconds": 120,
    "TaxonomyCacheSeconds": 900,
    "PopularSearchMinCount": 3
  },
  "Ranking": {
    "VotesWeight": 0.30,
    "FeatureOverlapWeight": 0.20,
    "PlatformWeight": 0.10,
    "CategoryWeight": 0.10,
    "RatingWeight": 0.15,
    "FreshnessWeight": 0.05,
    "EditorialWeight": 0.10,
    "FreshnessHalfLifeDays": 365,
    "RatingPriorWeight": 5,
    "RatingPriorMean": 3.5,
    "MinAlternativesForIndexing": 3
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "EnableSsl": true,
    "From": "no-reply@alternivo.com"
  }
}
