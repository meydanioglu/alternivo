# Copy to .env and fill in. deploy/setup-server.sh generates the secrets for you.

# Brand (can be renamed later without code changes; rebuild the web image after changing)
SITE_NAME=Alternivo
SITE_URL=https://alternivo.com
# Apex domain; www redirects to it. Caddy obtains HTTPS certificates automatically.
DOMAIN=alternivo.com

# Database
POSTGRES_DB=discovery
POSTGRES_USER=discovery
POSTGRES_PASSWORD=

# Shared secret between the Next.js server and the API (server-side rendering bypasses rate limits)
API_INTERNAL_KEY=

# First SuperAdmin account (created on startup if it does not exist)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Import seed/catalog.json on startup (idempotent; never overwrites editor-verified records)
SEED_ON_STARTUP=true

# Accounts must confirm their e-mail before signing in (needs SMTP below in production)
REQUIRE_CONFIRMED_EMAIL=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@alternivo.com

# AI content drafts (Admin → İçerik). Leave empty to disable generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Swagger UI on the API (only reachable via 127.0.0.1:8080 / SSH tunnel)
SWAGGER_ENABLED=false

# Optional host for logos/screenshots used with next/image
MEDIA_HOST=
