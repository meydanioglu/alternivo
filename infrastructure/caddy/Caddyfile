(site) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Uploaded images are served straight from the API's media store; everything else by Next.js.
	# The API itself is never exposed directly.
	handle /media/* {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy web:3000
	}
}

{$DOMAIN} {
	import site
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Requests to the bare server IP (or any other host name) go to the canonical HTTPS domain.
:80 {
	redir https://{$DOMAIN}{uri} permanent
}
