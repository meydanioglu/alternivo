(site) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Uploaded images are served straight from the API's media store; everything else by Next.js.
	# The API itself is never exposed directly.
	handle /media/* {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy web:3000
	}
}

{$DOMAIN} {
	import site
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# TEMPORARY: the bare server IP serves the site over plain HTTP (kept out of search engines).
# To turn it off again, replace this block with:  :80 { redir https://{$DOMAIN}{uri} permanent }
:80 {
	header X-Robots-Tag "noindex, nofollow"
	import site
}
