(site) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests"
		-Server
	}

	# Uploaded images are served straight from the API's media store; everything else by Next.js.
	# The API itself is never exposed directly.
	handle /media/* {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy web:3000
	}
}

{$DOMAIN} {
	import site
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Anything that is not the domain (bare IP, unknown Host headers, scanners) gets the connection dropped.
:80 {
	abort
}
