(site) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Next.js serves pages, sitemaps and the /bff proxy. The API is never exposed directly.
	reverse_proxy web:3000
}

{$DOMAIN} {
	import site
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Requests to the bare server IP (or any other host name) go to the canonical HTTPS domain.
:80 {
	redir https://{$DOMAIN}{uri} permanent
}
