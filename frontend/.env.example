# Public brand settings (baked in at build time)
NEXT_PUBLIC_SITE_NAME=Alternivo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only: where the Next.js server reaches the ASP.NET Core API
API_INTERNAL_URL=http://localhost:8080
# Must match Api__InternalKey on the API so server-side rendering is not rate limited
API_INTERNAL_KEY=change-me

# Optional: hostname allowed for remote logos/screenshots (next/image)
MEDIA_HOST=
